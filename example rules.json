{
  "1000": {
    "intentions": {

      "WORK": {
        "binaries": ["code", "libreoffice", "gimp"],
        "days": {
          "def": { "daily-time-budget": null, "time-windows": [{ "range": "05:00-24:00", "budget": null }] }
        }
      },

      "BROWSER": {
        "binaries": ["firefox"],
        "days": {
          "def": { "daily-time-budget": 900, "time-windows": [{ "range": "10:00-21:00", "budget": null }] }
        }
      },

      "VIDEO": {
        "binaries": ["vlc"],
        "days": {
          "def": { "daily-time-budget": 3600, "time-windows": [{ "range": "18:00-22:30", "budget": null }] },
          "sat": { "daily-time-budget": 7200, "time-windows": [{ "range": "10:00-22:30", "budget": null }] },
          "sun": { "daily-time-budget": 7200, "time-windows": [{ "range": "10:00-22:30", "budget": null }] }
        },
        "single": "true"
      }
    },

    "days_off": {
      "mon": [], "tue": [], "wed": [], "thu": [], "fri": [], "sat": [], "sun": []
    },

    "authorized_zones": ["/usr", "/opt", "/bin", "/sbin", "/lib", "/lib64"],
    "dev_zones": ["/home/example/projects"],

    "hooks": {}
  }
